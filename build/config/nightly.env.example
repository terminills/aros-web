# Copy to config/nightly.env on the build server.
ADT_REPO=https://github.com/aros-development-team/AROS.git
ADT_COMMIT=814720a9bcdd1bb93608c72434383102a54f6891
CHROMIUM_COMMIT=6bcf3f1a8d
CHROMIUM_DEPOT_TOOLS=/opt/depot_tools
PATCH_QUEUE=patches/series
TOOLCHAIN_TARBALL=/srv/artifacts/aros/toolchain-current.tar.zst
TOOLCHAIN_SHA256=
BUILD_ROOT=/srv/build/chromium-aros
ARTIFACT_ROOT=/srv/artifacts/chromium-aros
JOBS=32
ADT_TARGET=pc-x86_64
ADT_VARIANT=smp
ADT_TOOLCHAIN_MODE=prebuilt
HOSTED_TEST_COMMAND=/srv/testers/aros-hosted-site-test.sh
HOSTED_SITES='aros|https://www.aros.org youtube|https://www.youtube.com github|https://github.com'
HOSTED_SITE_TIMEOUT=180
CHROMIUM_GN_ARGS='is_component_build=false is_official_build=false use_system_v8=false target_os="aros"'
# The AROS printing integration includes the OOP printing Mojom interfaces.
CHROMIUM_GN_ARGS="$CHROMIUM_GN_ARGS enable_oop_printing=true"
