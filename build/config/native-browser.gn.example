# Native Chromium 124 configuration derived from the October 21 capture build.
# Replace the two absolute paths. CDM integration is disabled in this public example.
# This example is not the CEF archive configuration.
target_os = "aros"
target_cpu = "x64"
aros_toolchain_root = "/absolute/path/to/aros-crosstools"
aros_sysroot = "/absolute/path/to/adt-build/bin/pc-x86_64-smp/AROS/Developer"
is_debug = false
symbol_level = 0
is_component_build = false
is_clang = false
use_sysroot = false
use_custom_libcxx = false
enable_rust = false
treat_warnings_as_errors = false
use_remoteexec = false
use_goma = false
use_ozone = true
ozone_auto_platforms = false
ozone_platform = "aros"
ozone_platform_aros = true
ozone_platform_headless = false
use_aura = true
toolkit_views = true
use_glib = false
use_dbus = false
use_gio = false
use_gtk = false
use_pangocairo = false
use_alsa = false
use_pulseaudio = false
use_bluez = false
use_cups = false
use_udev = false
use_libpci = false
use_nss_certs = false
enable_nacl = false
enable_extensions = true
enable_print_preview = false
enable_printing = false
enable_pdf = false
media_use_ffmpeg = true
media_use_openh264 = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
rtc_use_h264 = false
rtc_use_pipewire = false
icu_use_data_file = false
v8_use_external_startup_data = false
v8_use_aros_library = true
aros_blink_modules_library_only = true
use_v8_context_snapshot = false
enable_base_tracing = true
use_perfetto_client_library = true
enable_perfetto_ipc = false
enable_perfetto_trace_processor_httpd = false
use_perfetto_trace_processor = false
angle_enable_vulkan = false
angle_build_vulkan_system_info = false
angle_shared_libvulkan = false
angle_enable_gl = true
angle_enable_null = true
angle_enable_swiftshader = false
headless_use_embedded_resources = false
headless_enable_commands = true
headless_use_prefs = false
headless_use_policy = false
enable_chromium_prelude = false
enable_cef = false
enable_basic_printing = false
enable_oop_printing = false
dcheck_always_on = false
enable_widevine = false
bundle_widevine_cdm = false
