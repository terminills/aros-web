include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/$(CURDIR)/../../build/chromium.mk
CEF_SOURCE ?= $(CHROMIUM_SRC)
CEF_OUTPUT ?= $(CEF_SOURCE)/out/aros-cef156
CEF_HEADERS := $(CEF_SOURCE)/cef
CEF_GENERATED_HEADERS := $(CEF_OUTPUT)/gen/cef
#MM workbench-tools-cefhost : workbench-libs-cef
%build_prog mmake=workbench-tools-cefhost \
    progname=CEFHost files=CEFHost targetdir=$(AROS_SYSTEM) \
    cflags="$(TARGET_ISA_CFLAGS) $(TARGET_CFLAGS) -DCEF_API_VERSION=15600 -I$(CEF_HEADERS) -I$(CEF_GENERATED_HEADERS) -I$(CEF_SOURCE)" \
    ldflags="$(TARGET_LDFLAGS)" uselibs="cef v8 dos exec debug"
#MM workbench-tools-cefhost-probe : workbench-libs-cef
%build_prog mmake=workbench-tools-cefhost-probe \
    progname=CEFHostProbe files=CEFHostProbe targetdir=$(AROS_SYSTEM) \
    uselibs="cef dos exec debug"
%common
