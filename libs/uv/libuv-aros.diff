+#ifdef __AROS__
+/* One uv1.library image serves every process in the guest, so file-level
+ * statics are guest-wide: two Node processes (a parent blocked in spawnSync
+ * and the C:Node it spawned) shared ONE default loop and ran each other's
+ * handles.  The default loop lives in the per-task library base instead
+ * (src-aros/aros-intbase.h, accessors in src-aros/aros-taskbase.c); the
+ * names below keep the upstream code unchanged. */
+uv_loop_t** uv_aros_default_loop_ptr(void);
+uv_loop_t* uv_aros_default_loop_struct(void);
+#define default_loop_struct (*uv_aros_default_loop_struct())
+#define default_loop_ptr (*uv_aros_default_loop_ptr())
+#else
 static uv_loop_t default_loop_struct;
 static uv_loop_t* default_loop_ptr;
+#endif
 
 
