diff -ruN libuv-v1.48.0.orig/include/uv/aros.h libuv-v1.48.0/include/uv/aros.h
--- libuv-v1.48.0.orig/include/uv/aros.h	1969-12-31 18:00:00.000000000 -0600
+++ libuv-v1.48.0/include/uv/aros.h	2026-09-15 07:11:13.941157378 -0500
@@ -0,0 +1,53 @@
+/* AROS custom event-loop backend platform loop fields.
+ *
+ * Core-first (no socket layer yet): the loop times out via timer.device and
+ * wakes early on an exec signal for uv_async and threadpool completion. The
+ * fields are opaque pointers and ints so this public header needs no exec or
+ * dos headers; src backend aros.c casts them.
+ *
+ * Fields: aros_timerport (MsgPort), aros_timerio (timerequest), aros_task
+ * (Task), aros_async_sig (signal bit or -1), aros_task_id (exec unique ID of
+ * aros_task).  All are owned by the task that runs the loop and are NULL/-1/0
+ * until it first polls (src-aros/aros.c uv__aros_loop_bind).
+ */
+#ifndef UV_AROS_H
+#define UV_AROS_H
+
+/*
+ * AROS's bsdsocket headers define socket/bind/connect/... as function-like
+ * LVO macros. Left defined they clobber C++ identifiers in EVERY consumer of
+ * this PUBLIC header (std::bind, V8InspectorSession::connect, ...). Undo them
+ * UNCONDITIONALLY: after <uv.h> the bsdsocket call-macros are OFF for everyone.
+ * uv1's own networking (src-aros/aros-net.c) reaches the raw LVOs in its own
+ * TU; a consumer that wants direct bsdsocket calls re-includes
+ * <proto/bsdsocket.h> after <uv.h>. (Previously this block was gated on
+ * UV_AROS_INTERNAL_BUILD, which fixed uv's own build but leaked the macros to
+ * C++ consumers like Node -- the exact std::bind/connect clobber.)
+ */
+#undef socket
+#undef connect
+#undef bind
+#undef listen
+#undef accept
+#undef send
+#undef recv
+#undef sendto
+#undef recvfrom
+#undef setsockopt
+#undef getsockopt
+#undef getsockname
+#undef getpeername
+#undef shutdown   /* left defined it turned uv__drain's shutdown(SHUT_WR) into a
+                     bsdsocket LVO call on a NULL SocketBase            */
+#undef sendmsg    /* uv__try_write / udp: through the macro they reached a
+                     process-global SocketBase; uv1 keeps one per task            */
+#undef recvmsg
+
+#define UV_PLATFORM_LOOP_FIELDS \
+  void* aros_timerport; \
+  void* aros_timerio; \
+  void* aros_task; \
+  int aros_async_sig; \
+  unsigned int aros_task_id;
+
+#endif /* UV_AROS_H */
